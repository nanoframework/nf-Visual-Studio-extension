<DataTemplate xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:vs="http://schemas.microsoft.com/visualstudio/extensibility/2022/xaml"
              xmlns:styles="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
              xmlns:colors="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0">
    <Grid x:Name="RootGrid"
          Width="460"
          Background="{DynamicResource {x:Static colors:ThemedDialogColors.WindowPanelBrushKey}}"
          TextElement.Foreground="{DynamicResource {x:Static colors:ThemedDialogColors.WindowPanelTextBrushKey}}">
        <Grid.Resources>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />

            <Style TargetType="Label" BasedOn="{StaticResource {x:Static styles:VsResourceKeys.ThemedDialogLabelStyleKey}}">
                <Setter Property="Padding" Value="0,3,8,3" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Static styles:VsResourceKeys.ThemedDialogTextBoxStyleKey}}">
                <Setter Property="Height" Value="23" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <Style TargetType="Button" BasedOn="{StaticResource {x:Static styles:VsResourceKeys.ThemedDialogButtonStyleKey}}">
                <Setter Property="MinWidth" Value="75" />
                <Setter Property="MinHeight" Value="23" />
                <Setter Property="Padding" Value="8,2" />
            </Style>

            <!-- validation message under a field: the space is always reserved, so the layout doesn't move when a message shows or hides -->
            <Style x:Key="ErrorTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource {x:Static colors:ThemedDialogColors.ValidationErrorTextBrushKey}}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="MinHeight" Value="16" />
                <Setter Property="AutomationProperties.LiveSetting" Value="Polite" />
            </Style>
        </Grid.Resources>

        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{Binding Introduction}" TextWrapping="Wrap" Margin="0,0,0,10" />

            <!-- token: a text box, masked by default by drawing bullets over it (Remote UI can't bind a PasswordBox) -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Label Grid.Column="0" Margin="0,3,0,0" VerticalAlignment="Top" Content="_Token:" Target="{Binding ElementName=TokenBox}" />
                <StackPanel Grid.Column="1" Margin="0,3">
                    <Grid ClipToBounds="True">
                        <TextBox x:Name="TokenBox"
                                 FontFamily="Consolas"
                                 Text="{Binding Token, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Authentication token">
                            <TextBox.Style>
                                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Static styles:VsResourceKeys.ThemedDialogTextBoxStyleKey}}">
                                    <Setter Property="Height" Value="23" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTokenHidden}" Value="True">
                                            <Setter Property="Foreground" Value="Transparent" />
                                            <Setter Property="CaretBrush" Value="{DynamicResource {x:Static colors:ThemedDialogColors.WindowPanelTextBrushKey}}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        <TextBlock Text="{Binding MaskedToken}"
                                   FontFamily="Consolas"
                                   Margin="4,0,0,0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Visibility="{Binding IsTokenHidden, Converter={StaticResource BooleanToVisibility}}" />
                    </Grid>
                    <CheckBox Margin="0,4,0,0"
                              Content="Sh_ow token"
                              IsChecked="{Binding IsTokenVisible, Mode=TwoWay}"
                              Style="{DynamicResource {x:Static styles:VsResourceKeys.ThemedDialogCheckBoxStyleKey}}" />
                    <TextBlock Style="{StaticResource ErrorTextStyle}" Text="{Binding TokenError}" />
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="OK" IsDefault="True" Command="{Binding OkCommand}" />
                <Button Margin="6,0,0,0" Content="Cancel" IsCancel="True" Command="{Binding CancelCommand}" />
            </StackPanel>
        </Grid>
    </Grid>
</DataTemplate>
