<DataTemplate xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:vs="http://schemas.microsoft.com/visualstudio/extensibility/2022/xaml"
              xmlns:styles="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
              xmlns:colors="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0">
    <Grid x:Name="RootGrid"
          Width="760"
          Height="470"
          Background="{DynamicResource {x:Static colors:ThemedDialogColors.WindowPanelBrushKey}}"
          TextElement.Foreground="{DynamicResource {x:Static colors:ThemedDialogColors.WindowPanelTextBrushKey}}">
        <Grid.Resources>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />

            <Style TargetType="Label" BasedOn="{StaticResource {x:Static styles:VsResourceKeys.ThemedDialogLabelStyleKey}}">
                <Setter Property="Padding" Value="0,3,8,3" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Static styles:VsResourceKeys.ThemedDialogTextBoxStyleKey}}">
                <Setter Property="Height" Value="23" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Static styles:VsResourceKeys.ThemedDialogComboBoxStyleKey}}">
                <Setter Property="Height" Value="23" />
                <Setter Property="DisplayMemberPath" Value="DisplayName" />
            </Style>
            <Style TargetType="Button" BasedOn="{StaticResource {x:Static styles:VsResourceKeys.ThemedDialogButtonStyleKey}}">
                <Setter Property="MinWidth" Value="75" />
                <Setter Property="MinHeight" Value="23" />
                <Setter Property="Padding" Value="8,2" />
            </Style>
            <Style TargetType="RadioButton" BasedOn="{StaticResource {x:Static styles:VsResourceKeys.ThemedDialogRadioButtonStyleKey}}">
                <Setter Property="Margin" Value="0,4,0,2" />
            </Style>

            <!-- validation message under a field, hidden while there's no message -->
            <Style x:Key="ErrorTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource {x:Static colors:ThemedDialogColors.ValidationErrorTextBrushKey}}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Margin" Value="0,2,0,0" />
                <Setter Property="AutomationProperties.LiveSetting" Value="Polite" />
                <Style.Triggers>
                    <Trigger Property="Text" Value="">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </Trigger>
                    <Trigger Property="Text" Value="{x:Null}">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- secondary text, e.g. explanations and the 2nd line of the profiles -->
            <Style x:Key="HintTextStyle" TargetType="TextBlock">
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Opacity" Value="0.75" />
            </Style>

            <!-- small tag in the list of profiles -->
            <Style x:Key="BadgeStyle" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource {x:Static colors:ThemedDialogColors.TagBackgroundBrushKey}}" />
                <Setter Property="BorderBrush" Value="{DynamicResource {x:Static colors:ThemedDialogColors.TagBorderBrushKey}}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource {x:Static colors:ThemedDialogColors.TagTextBrushKey}}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="2" />
                <Setter Property="Padding" Value="4,0" />
                <Setter Property="Margin" Value="4,0,0,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- flat tabs, themed -->
            <Style TargetType="TabControl">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0,1,0,0" />
                <Setter Property="BorderBrush" Value="{DynamicResource {x:Static colors:ThemedDialogColors.SectionDividerBrushKey}}" />
                <Setter Property="Padding" Value="0,10,0,0" />
            </Style>
            <Style TargetType="TabItem">
                <Setter Property="Foreground" Value="{DynamicResource {x:Static colors:ThemedDialogColors.WindowPanelTextBrushKey}}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Border x:Name="Chrome"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="0,0,0,2"
                                    Padding="10,4"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource {x:Static colors:ThemedDialogColors.ListItemMouseOverBrushKey}}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource {x:Static colors:ThemedDialogColors.SelectedItemActiveBrushKey}}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Chrome" Property="Opacity" Value="0.5" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0"
                    Margin="12,10,12,0"
                    SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}"
                    IsEnabled="{Binding IsIdle}">

            <!-- IPv4 -->
            <TabItem Header="IPv4" AutomationProperties.Name="IPv4">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Style="{DynamicResource {x:Static styles:VsResourceKeys.ScrollViewerStyleKey}}">
                    <StackPanel Margin="0,0,8,8">
                        <RadioButton GroupName="IPv4Mode" Content="Obtain an IP address _automatically (DHCP)" IsChecked="{Binding IsIPv4Dhcp, Mode=TwoWay}" />
                        <RadioButton GroupName="IPv4Mode" Content="_Use the following IP address:" IsChecked="{Binding IsIPv4Static, Mode=TwoWay}" />
                        <Grid Margin="20,4,0,0" IsEnabled="{Binding IsIPv4Static}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Label Grid.Row="0" Grid.Column="0" Content="IP a_ddress:" Target="{Binding ElementName=IPv4AddressBox}" />
                            <TextBox x:Name="IPv4AddressBox" Grid.Row="0" Grid.Column="1" Margin="0,3"
                                     Text="{Binding IPv4Address, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="IP address" />
                            <TextBlock Grid.Row="0" Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource ErrorTextStyle}" Text="{Binding IPv4AddressError}" />

                            <Label Grid.Row="1" Grid.Column="0" Content="Subnet _mask:" Target="{Binding ElementName=IPv4NetMaskBox}" />
                            <TextBox x:Name="IPv4NetMaskBox" Grid.Row="1" Grid.Column="1" Margin="0,3"
                                     Text="{Binding IPv4NetMask, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Subnet mask" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource ErrorTextStyle}" Text="{Binding IPv4NetMaskError}" />

                            <Label Grid.Row="2" Grid.Column="0" Content="Default _gateway:" Target="{Binding ElementName=IPv4GatewayBox}" />
                            <TextBox x:Name="IPv4GatewayBox" Grid.Row="2" Grid.Column="1" Margin="0,3"
                                     Text="{Binding IPv4Gateway, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Default gateway" />
                            <TextBlock Grid.Row="2" Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource ErrorTextStyle}" Text="{Binding IPv4GatewayError}" />
                        </Grid>

                        <RadioButton GroupName="DnsMode" Margin="0,14,0,2" Content="Obtain DNS server address au_tomatically" IsChecked="{Binding IsDnsAutomatic, Mode=TwoWay}" />
                        <RadioButton GroupName="DnsMode" Content="Use the following DNS _server addresses:" IsChecked="{Binding IsDnsManual, Mode=TwoWay}" />
                        <Grid Margin="20,4,0,0" IsEnabled="{Binding IsDnsManual}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Label Grid.Row="0" Grid.Column="0" Content="_Preferred DNS server:" Target="{Binding ElementName=Dns1Box}" />
                            <TextBox x:Name="Dns1Box" Grid.Row="0" Grid.Column="1" Margin="0,3"
                                     Text="{Binding Dns1Address, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Preferred DNS server" />
                            <TextBlock Grid.Row="0" Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource ErrorTextStyle}" Text="{Binding Dns1AddressError}" />

                            <Label Grid.Row="1" Grid.Column="0" Content="A_lternate DNS server:" Target="{Binding ElementName=Dns2Box}" />
                            <TextBox x:Name="Dns2Box" Grid.Row="1" Grid.Column="1" Margin="0,3"
                                     Text="{Binding Dns2Address, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Alternate DNS server" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource ErrorTextStyle}" Text="{Binding Dns2AddressError}" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- network interface -->
            <TabItem Header="Network Interface" AutomationProperties.Name="Network Interface">
                <Grid Margin="0,0,8,8" VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Label Grid.Row="0" Grid.Column="0" Content="_MAC address:" Target="{Binding ElementName=MacAddressBox}" />
                    <TextBox x:Name="MacAddressBox" Grid.Row="0" Grid.Column="1" Margin="0,3"
                             Text="{Binding MacAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding CanChangeMacAddress}"
                             AutomationProperties.Name="MAC address" />
                    <TextBlock Grid.Row="0" Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource ErrorTextStyle}" Text="{Binding MacAddressError}" />

                    <Label Grid.Row="1" Grid.Column="0" Content="_Interface type:" Target="{Binding ElementName=InterfaceTypeBox}" />
                    <ComboBox x:Name="InterfaceTypeBox" Grid.Row="1" Grid.Column="1" Margin="0,3"
                              ItemsSource="{Binding InterfaceTypeOptions}"
                              SelectedItem="{Binding InterfaceType, Mode=TwoWay}"
                              IsEnabled="{Binding CanChangeInterfaceType}"
                              AutomationProperties.Name="Interface type" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,10,0,0" Style="{StaticResource HintTextStyle}"
                               Text="The MAC address can be changed only on devices that allow it. The interface type can be chosen only if the device doesn't report a valid one." />
                </Grid>
            </TabItem>

            <!-- Wi-Fi profiles: list of the profiles stored in the device, and the editor of the selected one -->
            <TabItem Header="Wi-Fi profiles" IsEnabled="{Binding IsWireless}" AutomationProperties.Name="Wi-Fi profiles">
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="250" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ListView x:Name="ProfilesList"
                             Grid.Row="0" Grid.Column="0"
                             ItemsSource="{Binding WifiProfiles}"
                             SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                             SelectionMode="Single"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             Style="{DynamicResource {x:Static styles:VsResourceKeys.ThemedDialogListViewStyleKey}}"
                             AutomationProperties.Name="Wi-Fi profiles">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Static styles:VsResourceKeys.ThemedDialogListViewItemStyleKey}}">
                                <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
                                <Setter Property="Padding" Value="4,3" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding SlotText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding Summary}" TextTrimming="CharacterEllipsis" Style="{StaticResource HintTextStyle}" TextWrapping="NoWrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                        <vs:Image Source="KnownMonikers.StatusWarning" Width="16" Height="16" Margin="4,0,0,0"
                                                  ToolTip="Another profile has the same SSID."
                                                  Visibility="{Binding HasDuplicateSsid, Converter={StaticResource BooleanToVisibility}}" />
                                        <vs:Image Source="KnownMonikers.StatusError" Width="16" Height="16" Margin="4,0,0,0"
                                                  ToolTip="This profile has values that can't be saved."
                                                  Visibility="{Binding HasErrors, Converter={StaticResource BooleanToVisibility}}" />
                                        <Border Style="{StaticResource BadgeStyle}" ToolTip="The device connects with this profile when it starts."
                                                Visibility="{Binding IsUsedAtStartup, Converter={StaticResource BooleanToVisibility}}">
                                            <TextBlock Text="Startup" />
                                        </Border>
                                        <Border Style="{StaticResource BadgeStyle}" ToolTip="Changed, it will be written to the device with OK."
                                                Visibility="{Binding IsModified, Converter={StaticResource BooleanToVisibility}}">
                                            <TextBlock Text="Modified" />
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,6,0,0" Style="{StaticResource HintTextStyle}" Text="{Binding WifiProfilesSummary}" />

                    <!-- editor of the selected profile -->
                    <TextBlock Grid.Row="0" Grid.Column="1" Margin="16,0,0,0" Text="Select a profile to edit it.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource HintTextStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelectedProfile}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ScrollViewer Grid.Row="0" Grid.Column="1" Margin="16,0,0,0"
                                  VerticalScrollBarVisibility="Auto"
                                  Style="{DynamicResource {x:Static styles:VsResourceKeys.ScrollViewerStyleKey}}"
                                  Visibility="{Binding HasSelectedProfile, Converter={StaticResource BooleanToVisibility}}">
                        <Grid DataContext="{Binding SelectedProfile}" Margin="0,0,8,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="95" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,6" FontWeight="SemiBold">
                                <Run Text="Slot" /> <Run Text="{Binding SlotText, Mode=OneWay}" />
                            </TextBlock>

                            <!-- SSID -->
                            <Label Grid.Row="1" Grid.Column="0" Margin="0,3,0,0" VerticalAlignment="Top" Content="_SSID:" Target="{Binding ElementName=SsidBox}" />
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,3">
                                <TextBox x:Name="SsidBox" HorizontalAlignment="Left" Width="240" MaxLength="32"
                                         Text="{Binding Ssid, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="SSID" />
                                <TextBlock Style="{StaticResource ErrorTextStyle}" Text="{Binding SsidError}" />
                                <TextBlock Margin="0,2,0,0" Style="{StaticResource HintTextStyle}" Text="Another profile has the same SSID."
                                           Visibility="{Binding HasDuplicateSsid, Converter={StaticResource BooleanToVisibility}}" />
                            </StackPanel>

                            <!-- password: a text box, masked by default by drawing bullets over it (Remote UI can't bind a PasswordBox) -->
                            <Label Grid.Row="2" Grid.Column="0" Margin="0,3,0,0" VerticalAlignment="Top" Content="_Password:" Target="{Binding ElementName=PasswordTextBox}" />
                            <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,3">
                                <!-- same width as the other text boxes: a longer password scrolls, the bullets are clipped to the box -->
                                <Grid Width="240" HorizontalAlignment="Left" ClipToBounds="True">
                                    <TextBox x:Name="PasswordTextBox"
                                             MaxLength="63"
                                             FontFamily="Consolas"
                                             Text="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="Password">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Static styles:VsResourceKeys.ThemedDialogTextBoxStyleKey}}">
                                                <Setter Property="Height" Value="23" />
                                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPasswordHidden}" Value="True">
                                                        <Setter Property="Foreground" Value="Transparent" />
                                                        <Setter Property="CaretBrush" Value="{DynamicResource {x:Static colors:ThemedDialogColors.WindowPanelTextBrushKey}}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                    <TextBlock Text="{Binding MaskedPassword}"
                                               FontFamily="Consolas"
                                               Margin="4,0,0,0"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False"
                                               Visibility="{Binding IsPasswordHidden, Converter={StaticResource BooleanToVisibility}}" />
                                </Grid>
                                <CheckBox Margin="0,4,0,0"
                                          Content="Sh_ow password"
                                          IsChecked="{Binding IsPasswordVisible, Mode=TwoWay}"
                                          Style="{DynamicResource {x:Static styles:VsResourceKeys.ThemedDialogCheckBoxStyleKey}}" />
                                <TextBlock Style="{StaticResource ErrorTextStyle}" Text="{Binding PasswordError}" />
                            </StackPanel>

                            <!-- security -->
                            <Label Grid.Row="3" Grid.Column="0" Content="_Authentication:" Target="{Binding ElementName=AuthenticationBox}" />
                            <ComboBox x:Name="AuthenticationBox" Grid.Row="3" Grid.Column="1" Margin="0,3" HorizontalAlignment="Left" Width="240"
                                      ItemsSource="{Binding AuthenticationOptions}"
                                      SelectedItem="{Binding Authentication, Mode=TwoWay}"
                                      AutomationProperties.Name="Authentication" />

                            <Label Grid.Row="4" Grid.Column="0" Content="_Encryption:" Target="{Binding ElementName=EncryptionBox}" />
                            <ComboBox x:Name="EncryptionBox" Grid.Row="4" Grid.Column="1" Margin="0,3" HorizontalAlignment="Left" Width="240"
                                      ItemsSource="{Binding EncryptionOptions}"
                                      SelectedItem="{Binding Encryption, Mode=TwoWay}"
                                      AutomationProperties.Name="Encryption" />

                            <Label Grid.Row="5" Grid.Column="0" Content="_Radio:" Target="{Binding ElementName=RadioBox}" />
                            <ComboBox x:Name="RadioBox" Grid.Row="5" Grid.Column="1" Margin="0,3" HorizontalAlignment="Left" Width="240"
                                      ItemsSource="{Binding RadioOptions}"
                                      SelectedItem="{Binding Radio, Mode=TwoWay}"
                                      AutomationProperties.Name="Radio" />

                            <Label Grid.Row="6" Grid.Column="0" Content="Op_tions:" Target="{Binding ElementName=OptionsBox}" />
                            <ComboBox x:Name="OptionsBox" Grid.Row="6" Grid.Column="1" Margin="0,3" HorizontalAlignment="Left" Width="240"
                                      ItemsSource="{Binding ConfigurationOptions}"
                                      SelectedItem="{Binding Options, Mode=TwoWay}"
                                      AutomationProperties.Name="Options" />

                            <TextBlock Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,8,0,0" Style="{StaticResource HintTextStyle}"
                                       Text="The device connects with this profile when it starts."
                                       Visibility="{Binding IsUsedAtStartup, Converter={StaticResource BooleanToVisibility}}" />
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- certificates -->
            <TabItem Header="Certificates" AutomationProperties.Name="Certificates">
                <StackPanel Margin="0,0,8,8">
                    <TextBlock Text="Root CA" FontWeight="SemiBold" />
                    <TextBlock Margin="0,2,0,0" Style="{StaticResource HintTextStyle}" Text="The certificate authorities the device trusts, e.g. to connect with TLS." />
                    <TextBlock Margin="0,6,0,0" Text="{Binding RootCaStatus}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                    <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                        <Button Content="_Browse..." Command="{Binding BrowseRootCaCommand}" AutomationProperties.Name="Browse for a Root CA file" />
                        <Button Margin="6,0,0,0" Content="_Clear" Command="{Binding ClearRootCaCommand}" AutomationProperties.Name="Clear the Root CA stored in the device" />
                        <Button Margin="6,0,0,0" Content="_Don't change" Command="{Binding KeepRootCaCommand}"
                                Visibility="{Binding HasRootCaToSave, Converter={StaticResource BooleanToVisibility}}"
                                AutomationProperties.Name="Don't change the Root CA" />
                    </StackPanel>

                    <TextBlock Margin="0,20,0,0" Text="Device certificate" FontWeight="SemiBold" />
                    <TextBlock Margin="0,2,0,0" Style="{StaticResource HintTextStyle}" Text="The certificate the device presents, e.g. to authenticate with a cloud service." />
                    <TextBlock Margin="0,6,0,0" Text="{Binding DeviceCertificateStatus}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                    <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                        <Button Content="B_rowse..." Command="{Binding BrowseDeviceCertificateCommand}" AutomationProperties.Name="Browse for a device certificate file" />
                        <Button Margin="6,0,0,0" Content="C_lear" Command="{Binding ClearDeviceCertificateCommand}" AutomationProperties.Name="Clear the device certificate stored in the device" />
                        <Button Margin="6,0,0,0" Content="Do_n't change" Command="{Binding KeepDeviceCertificateCommand}"
                                Visibility="{Binding HasDeviceCertificateToSave, Converter={StaticResource BooleanToVisibility}}"
                                AutomationProperties.Name="Don't change the device certificate" />
                    </StackPanel>
                </StackPanel>
            </TabItem>
        </TabControl>

        <!-- status and buttons -->
        <Grid Grid.Row="1" Margin="12,10,12,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                <TextBlock Style="{StaticResource ErrorTextStyle}" Margin="0" Text="{Binding ErrorSummary}" />
                <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive"
                           Visibility="{Binding HasStatusText, Converter={StaticResource BooleanToVisibility}}" />
                <ProgressBar Height="4" Margin="0,3,0,0"
                             Style="{DynamicResource {x:Static styles:VsResourceKeys.ProgressBarStyleKey}}"
                             IsIndeterminate="{Binding IsSaving}"
                             Visibility="{Binding IsSaving, Converter={StaticResource BooleanToVisibility}}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Content="OK" IsDefault="True" Command="{Binding OkCommand}" IsEnabled="{Binding CanSave}" />
                <Button Margin="6,0,0,0" Content="Cancel" IsCancel="True" Command="{Binding CancelCommand}" IsEnabled="{Binding IsIdle}" />
            </StackPanel>
        </Grid>
    </Grid>
</DataTemplate>
