<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <Platforms>AnyCPU;x64</Platforms>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <OutputType>Library</OutputType>
    <RootNamespace>nanoFramework.Tools.VisualStudio.Extension</RootNamespace>
    <AssemblyName>nanoFramework.Tools.VS2022.Extension</AssemblyName>
    <LangVersion>latest</LangVersion>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ErrorReport>prompt</ErrorReport>
    <MinimumVisualStudioVersion>17.0</MinimumVisualStudioVersion>
    <DefineConstants>$(DefineConstants);DEV17</DefineConstants>
    <NF_Build_VS2022>True</NF_Build_VS2022>

    <!-- keep the output layout of the old style project (no TFM folder) -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

    <!-- AssemblyInfo.cs is maintained by hand, Nerdbank.GitVersioning provides the version attributes -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- do not generate version info for local builds -->
    <GenerateAssemblyVersionInfo Condition="'$(Configuration)' == 'Debug'">false</GenerateAssemblyVersionInfo>

    <SignAssembly>false</SignAssembly>
    <AssemblyOriginatorKeyFile>Key.snk</AssemblyOriginatorKeyFile>

    <!-- VSIX: VSSDK + VisualStudio.Extensibility hybrid -->
    <VssdkCompatibleExtension>true</VssdkCompatibleExtension>
    <GeneratePkgDefFile>true</GeneratePkgDefFile>
    <UseCodebase>true</UseCodebase>
    <CreateVsixContainer>True</CreateVsixContainer>
    <IncludeAssemblyInVSIXContainer>true</IncludeAssemblyInVSIXContainer>
    <IncludeDebugSymbolsInVSIXContainer>false</IncludeDebugSymbolsInVSIXContainer>
    <IncludeDebugSymbolsInLocalVSIXDeployment>true</IncludeDebugSymbolsInLocalVSIXDeployment>
    <CopyBuildOutputToOutputDirectory>true</CopyBuildOutputToOutputDirectory>
    <CopyOutputSymbolsToOutputDirectory>true</CopyOutputSymbolsToOutputDirectory>
    <StartAction>Program</StartAction>
    <StartProgram Condition="'$(DevEnvDir)' != ''">$(DevEnvDir)devenv.exe</StartProgram>
    <StartArguments>/rootSuffix Exp</StartArguments>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DeployExtension Condition="'$(DeployExtension)' == ''">True</DeployExtension>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DeployExtension Condition="'$(DeployExtension)' == ''">False</DeployExtension>
  </PropertyGroup>

  <!-- the old style project listed every file; make sure the globs only pick up what it did -->
  <ItemGroup>
    <Compile Remove="bin\**;obj\**" />
    <Page Remove="Resources\**;Rules\**" />
    <None Remove="bin\**;obj\**" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Tools.BuildTasks-2019\ProcessResourceFiles.cs">
      <Link>ResXFileCodeGenerator\ProcessResourceFiles.cs</Link>
    </Compile>
    <Compile Include="..\Tools.BuildTasks-2019\Utilities\DebuggerHelper.cs">
      <Link>DebuggerHelper.cs</Link>
    </Compile>
    <Compile Update="NanoFrameworkMoniker.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>NanoFrameworkMoniker.vsct</DependentUpon>
    </Compile>
    <Compile Update="Resources\ResourceStrings.Designer.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>ResourceStrings.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <Content Include="$(PkgnanoFramework_CoreLibrary)\nanoFramework.CoreLibrary.2.0.0-preview.30.nupkg">
      <Link>Packages\nanoFramework.CoreLibrary.2.0.0-preview.30.nupkg</Link>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <Content Include="$(PkgnanoFramework_TestFramework)\nanoFramework.TestFramework.4.0.0-preview.45.nupkg">
      <Link>Packages\nanoFramework.TestFramework.4.0.0-preview.45.nupkg</Link>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <Content Include="Resources\nF_logo_128.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <Content Include="Resources\nF_logo_32.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <Content Include="Resources\nanoFramework.ico">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <Content Include="license.txt">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <Content Include="NanoFrameworkMoniker.imagemanifest">
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>

    <!-- images for VisualStudio.Extensibility (ImageMoniker.Custom), by file name -->
    <Content Include="Images\*.png">
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>

    <!-- MSBuild targets deployed to the MSBuild folder -->
    <Content Include="Targets\*.*">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <IncludeInVSIX>true</IncludeInVSIX>
      <InstallRoot>MSBuild</InstallRoot>
      <VSIXSubPath>nanoFramework\v1.0\</VSIXSubPath>
    </Content>

    <!-- CPS rules -->
    <Content Include="Rules\*.xaml">
      <InstallRoot>MSBuild</InstallRoot>
      <VSIXSubPath>nanoFramework\v1.0\Rules\</VSIXSubPath>
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>

    <VSCTCompile Include="NanoFrameworkMoniker.vsct" />
    <VSCTCompile Include="NanoFrameworkPackage.vsct">
      <ResourceName>Menus.ctmenu</ResourceName>
    </VSCTCompile>

    <!-- Only Include app.config for local debugging -->
    <None Remove="app.config" />
    <None Include="app.config" Condition="'$(Configuration)' == 'Debug'" />
    <None Include="Key.snk" />
    <None Update="source.extension.vsixmanifest">
      <SubType>Designer</SubType>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\*.xaml" />
    <Resource Include="Resources\*.16.16.png" />
    <Resource Include="Resources\nF_logo_128.png" />
  </ItemGroup>

  <ItemGroup>
    <Page Update="ToolWindow.DeviceExplorer\HelpDialog.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
  </ItemGroup>

  <ItemGroup>
    <XamlPropertyRule Include="Rules\*.xaml" Exclude="Rules\nfProjectItemsSchema.xaml;Rules\EmbeddedResource.BrowseObject.xaml;Rules\None.BrowseObject.xaml">
      <Generator>MSBuild:GenerateRuleSourceFromXaml</Generator>
    </XamlPropertyRule>
    <XamlPropertyRuleNoCodeBehind Include="Rules\EmbeddedResource.BrowseObject.xaml" />
    <XamlPropertyRuleNoCodeBehind Include="Rules\None.BrowseObject.xaml" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources\ResourceStrings.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>ResourceStrings.Designer.cs</LastGenOutput>
      <SubType>Designer</SubType>
    </EmbeddedResource>
    <EmbeddedResource Update="VSPackage.resx">
      <MergeWithCTO>true</MergeWithCTO>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.ComponentModel.Composition" />
    <Reference Include="System.ComponentModel.DataAnnotations" />
    <Reference Include="System.Configuration" />
    <Reference Include="System.Design" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Numerics" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.Security" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="WindowsFormsIntegration" />
  </ItemGroup>

  <ItemGroup>
    <!-- templates and build tasks packed into the VSIX -->
    <ProjectReference Include="..\CSharp.AssemblyInfoTemplate\CSharp.AssemblyInfoTemplate.csproj">
      <Name>CSharp.AssemblyInfoTemplate</Name>
      <VSIXSubPath>ItemTemplates</VSIXSubPath>
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <IncludeOutputGroupsInVSIX>TemplateProjectOutputGroup%3b</IncludeOutputGroupsInVSIX>
    </ProjectReference>
    <ProjectReference Include="..\CSharp.BlankApplication\CSharp.BlankApplication-vs2022.csproj">
      <Name>CSharp.BlankApplication-vs2022</Name>
      <VSIXSubPath>ProjectTemplates</VSIXSubPath>
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <IncludeOutputGroupsInVSIX>TemplateProjectOutputGroup%3b</IncludeOutputGroupsInVSIX>
    </ProjectReference>
    <ProjectReference Include="..\CSharp.ClassLibrary\CSharp.ClassLibrary-vs2022.csproj">
      <Name>CSharp.ClassLibrary-vs2022</Name>
      <VSIXSubPath>ProjectTemplates</VSIXSubPath>
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <IncludeOutputGroupsInVSIX>TemplateProjectOutputGroup%3b</IncludeOutputGroupsInVSIX>
    </ProjectReference>
    <ProjectReference Include="..\CSharp.ClassTemplate\CSharp.ClassTemplate.csproj">
      <Name>CSharp.ClassTemplate</Name>
      <VSIXSubPath>ItemTemplates</VSIXSubPath>
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <IncludeOutputGroupsInVSIX>TemplateProjectOutputGroup%3b</IncludeOutputGroupsInVSIX>
    </ProjectReference>
    <ProjectReference Include="..\CSharp.ResourceTemplate\CSharp.ResourceTemplate.csproj">
      <Name>CSharp.ResourceTemplate</Name>
      <IncludeOutputGroupsInVSIX>TemplateProjectOutputGroup%3b</IncludeOutputGroupsInVSIX>
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <VSIXSubPath>ItemTemplates</VSIXSubPath>
    </ProjectReference>
    <ProjectReference Include="..\CSharp.TestApplication\CSharp.TestApplication-vs2022.csproj">
      <Name>CSharp.TestApplication-vs2022</Name>
      <IncludeOutputGroupsInVSIX>TemplateProjectOutputGroup%3b</IncludeOutputGroupsInVSIX>
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <VSIXSubPath>ProjectTemplates</VSIXSubPath>
    </ProjectReference>
    <ProjectReference Include="..\Tools.BuildTasks-2022\Tools.BuildTasks-2022.csproj">
      <Name>Tools.BuildTasks-2022</Name>
      <InstallRoot>MSBuild</InstallRoot>
      <IncludeOutputGroupsInVSIX>BuiltProjectOutputGroup</IncludeOutputGroupsInVSIX>
      <VSIXSubPath>nanoFramework\v1.0\</VSIXSubPath>
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Monitor.OpenTelemetry.Exporter" Version="1.8.0" />
    <PackageReference Include="CliWrap" Version="3.6.7" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.3" />
    <PackageReference Include="Microsoft.VisualStudio.Composition" Version="17.13.41" />
    <PackageReference Include="Microsoft.VisualStudio.Debugger.Engine" Version="17.14.1051801" />
    <PackageReference Include="Microsoft.VisualStudio.Extensibility.Build" Version="17.14.40608" PrivateAssets="all" />
    <PackageReference Include="Microsoft.VisualStudio.Extensibility.Sdk" Version="17.14.40608" PrivateAssets="all" />
    <PackageReference Include="Microsoft.VisualStudio.ProjectSystem.Sdk" Version="17.9.380" />
    <PackageReference Include="Microsoft.VisualStudio.SDK" Version="17.14.40265" />
    <PackageReference Include="nanoFramework.CoreLibrary" Version="2.0.0-preview.30" GeneratePathProperty="true">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="nanoFramework.TestFramework" Version="4.0.0-preview.45" GeneratePathProperty="true">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="nanoFramework.Tools.Debugger.Net" Version="3.0.0-preview.29" />
    <PackageReference Include="nanoFramework.Tools.MetadataProcessor.MsBuildTask" Version="4.0.0-preview.108" />
    <PackageReference Include="Nerdbank.GitVersioning" Version="3.10.85">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="NuGet.VisualStudio" Version="17.14.0" />
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="17.14.2142" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers" />
    <PackageReference Include="OpenTelemetry" Version="1.15.3" />
  </ItemGroup>

  <Import Project="..\vs-extension.shared\vs-extension.shared.projitems" Label="Shared" />
  <Import Project="PrepareImageManifest.targets" />
</Project>
