<vsp:DialogWindow
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vsp="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
             xmlns:vss="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
             xmlns:imaging="clr-namespace:Microsoft.VisualStudio.Imaging;assembly=Microsoft.VisualStudio.Imaging"
             xmlns:theming="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Imaging"
             xmlns:utilities="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Utilities"
             x:Class="nanoFramework.Tools.VisualStudio.Extension.HelpDialog"
             Background="{DynamicResource {x:Static vsp:EnvironmentColors.ToolWindowBackgroundBrushKey}}"
             Foreground="{DynamicResource {x:Static vsp:EnvironmentColors.ToolWindowTextBrushKey}}"
             HasDialogFrame="False"
             ShowInTaskbar="False"
             ResizeMode="NoResize"
             SizeToContent="Height"
             Width="480"
             WindowStartupLocation="CenterOwner"
             Title=".NET nanoFramework Help">
    <vsp:DialogWindow.Resources>
        <utilities:BrushToColorConverter x:Key="BrushToColorConverter" />

        <Style x:Key="SecondaryTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsp:EnvironmentColors.SystemGrayTextBrushKey}}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </vsp:DialogWindow.Resources>

    <Grid theming:ImageThemingUtilities.ImageBackgroundColor="{Binding Background, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BrushToColorConverter}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- links, each with what it's for and what to do there -->
        <StackPanel Grid.Row="0" Margin="16,14,16,8">
            <TextBlock Text="Get help and get involved" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" />

            <ItemsControl x:Name="Links" Focusable="False" AutomationProperties.Name="Links">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <imaging:CrispImage Grid.Column="0" Moniker="{Binding Moniker}" Width="16" Height="16" Margin="0,1,10,0" VerticalAlignment="Top" />
                            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Description}" Style="{StaticResource SecondaryTextStyle}" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" VerticalAlignment="Center">
                                <Hyperlink Style="{DynamicResource {x:Static vss:VsResourceKeys.ThemedDialogHyperlinkStyleKey}}"
                                           NavigateUri="{Binding Url}"
                                           RequestNavigate="Link_RequestNavigate"
                                           ToolTip="{Binding Url}"
                                           AutomationProperties.Name="{Binding Action}">
                                    <Run Text="{Binding Action, Mode=OneWay}" />
                                </Hyperlink>
                            </TextBlock>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- about -->
        <Border Grid.Row="1"
                Padding="16,12"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource {x:Static vsp:EnvironmentColors.ToolWindowBorderBrushKey}}"
                Background="{DynamicResource {x:Static vsp:EnvironmentColors.ToolWindowContentGridBrushKey}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image Grid.Column="0"
                       Source="pack://application:,,,/nanoFramework.Tools.VS2022.Extension;component/Resources/nF_logo_128.png"
                       Width="40" Height="40"
                       Margin="0,0,12,0"
                       VerticalAlignment="Top"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       AutomationProperties.Name=".NET nanoFramework logo" />
                <StackPanel Grid.Column="1">
                    <TextBlock Text=".NET nanoFramework extension for Visual Studio" FontWeight="SemiBold" />
                    <TextBlock x:Name="VersionText" Style="{StaticResource SecondaryTextStyle}" />
                    <TextBlock Text="Copyright (c) .NET Foundation and Contributors. MIT License." Style="{StaticResource SecondaryTextStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="16,10,16,12">
            <Button Content="Close"
                    MinWidth="75"
                    IsCancel="True"
                    IsDefault="True"
                    Click="CloseButton_Click"
                    Style="{DynamicResource {x:Static vss:VsResourceKeys.ThemedDialogButtonStyleKey}}" />
        </StackPanel>
    </Grid>
</vsp:DialogWindow>
